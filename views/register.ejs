<%- include('header', { title: 'Регистрация | Alain Robyn' }) %>

<div class="max-w-md mx-auto py-12 px-4 pt-24">
  <h1 class="text-3xl font-bold mb-8 text-center">Регистрация</h1>
  
  <div class="bg-white rounded-lg shadow-lg p-8">
    <form action="/register" method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-medium mb-2">Имя</label>
        <input type="text" name="name" required 
          class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:border-black">
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Email</label>
        <input type="email" name="email" required 
          class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:border-black">
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Пароль</label>
        <input type="password" name="password" required 
          class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:border-black">
      </div>
      
      <div>
        <label class="block text-sm font-medium mb-2">Подтвердите пароль</label>
        <input type="password" name="confirm_password" required 
          class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:border-black">
      </div>
      
      <div class="flex items-center">
        <input type="checkbox" id="terms" name="terms" required class="mr-2">
        <label for="terms" class="text-sm">
          Я согласен с <a href="#" class="text-blue-600 hover:underline">условиями использования</a>
        </label>
      </div>
      
      <div class="flex items-center mb-6">
  <input type="checkbox" id="isBuyer" name="isBuyer" class="mr-3 h-5 w-5 text-black focus:ring-black border-gray-300 rounded">
  <label for="isBuyer" class="text-sm text-gray-700">
    Я хочу стать оптовым партнером (байером)
  </label>
</div>

      <button type="submit" 
        class="w-full bg-black text-white py-3 rounded font-medium hover:bg-gray-800">
        Зарегистрироваться
      </button>
      
      <div class="text-center">
        <p class="text-sm text-gray-600">Уже есть аккаунт?</p>
        <a href="/login" class="text-sm text-blue-600 hover:underline">
          Войти
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('footer') %>