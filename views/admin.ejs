<%- include('header', { title: 'Админ-панель | Alain Robyn' }) %>

<div class="max-w-7xl mx-auto py-12 px-6 pt-24">
  <h1 class="text-5xl font-bold mb-12 text-center">Админ-панель</h1>

  <!-- Форма добавления товара -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-12">
    <h2 class="text-3xl font-bold mb-8">Добавить новый товар</h2>
    <form action="/admin/add-product" method="POST" enctype="multipart/form-data" class="grid md:grid-cols-2 gap-6">
      <div>
        <label class="block font-medium mb-2">Название</label>
        <input type="text" name="name" required class="w-full border rounded-lg px-4 py-3">
      </div>
      <div>
        <label class="block font-medium mb-2">Цена (€)</label>
        <input type="number" step="0.01" name="price" required class="w-full border rounded-lg px-4 py-3">
      </div>
      <div>
        <label class="block font-medium mb-2">Описание</label>
        <textarea name="description" rows="3" class="w-full border rounded-lg px-4 py-3"></textarea>
      </div>
      <div>
        <label class="block font-medium mb-2">Категория</label>
        <select name="category" class="w-full border rounded-lg px-4 py-3">
          <option value="men">Men</option>
          <option value="women">Women</option>
          <option value="unisex">Unisex</option>
        </select>
      </div>
      <div>
        <label class="block font-medium mb-2">Тип</label>
        <select name="type" class="w-full border rounded-lg px-4 py-3">
          <option value="pants">Pants</option>
          <option value="tshirt">T-shirt</option>
          <option value="belt">Belt</option>
          <option value="jacket">Jacket</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div>
        <label class="block font-medium mb-2">Фото товара</label>
        <input type="file" name="image" accept="image/*" required class="w-full">
      </div>
      <div class="md:col-span-2">
        <button type="submit" class="bg-black text-white px-10 py-4 rounded-lg font-bold hover:bg-gray-800 transition">
          Добавить товар
        </button>
      </div>
    </form>
  </div>

  <!-- Список товаров -->
  <div class="bg-white rounded-2xl shadow-xl p-8">
    <h2 class="text-3xl font-bold mb-8">Товары в каталоге (<%= products.length %>)</h2>
    <div class="grid gap-6">
      <% products.forEach(product => { %>
        <div class="flex items-center justify-between border-b pb-6 last:border-0">
          <div class="flex items-center gap-6">
            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-24 h-24 object-cover rounded-lg">
            <div>
              <p class="text-xl font-bold"><%= product.name %></p>
              <p class="text-gray-600">€<%= product.price %> | <%= product.category %> | <%= product.type %></p>
              <p class="text-sm text-gray-500 mt-1"><%= product.description || 'Нет описания' %></p>
            </div>
          </div>
          <div class="flex gap-4">
            <a href="/admin/edit-product/<%= product.id %>" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700">
              Редактировать
            </a>
            <form action="/admin/delete-product/<%= product.id %>" method="POST" onsubmit="return confirm('Удалить товар навсегда?')">
              <button type="submit" class="bg-red-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-red-700">
                Удалить
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include('footer') %>