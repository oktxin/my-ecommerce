<%- include('header', { title: 'Каталог | Alain Robyn' }) %>

<div class="w-full py-0 px-4 md:px-8">
  <!-- Сетка товаров -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-screen-2xl mx-auto">
    <% if (products.length > 0) { %>
      <% products.forEach((product, index) => { %>
        <div class="product-item group bg-white rounded-2xl overflow-hidden shadow-lg transition-all duration-500 hover:shadow-2xl hover:-translate-y-6 opacity-0 animate-fadeIn"
             style="animation-delay: '<%= index * 0.1 %>'s;">
          <a href="/product/<%= product.id %>" class="block">
            <div class="relative w-full h-96 md:h-[560px] bg-gray-50 overflow-hidden">
              <img
                src="<%= product.image %>"
                alt="<%= product.name %>"
                class="w-full h-full object-contain p-8 transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
            </div>

            <div class="p-6 text-center">
              <h3 class="text-sm font-medium text-gray-700 mb-3 truncate"><%= product.name %></h3>
              
              <p class="font-bold text-xl mb-2">
                <% if (locals.user && user.role === 'buyer') { %>
                  <% const discount = user.discount || 20; %>
                  <% const wholesalePrice = (product.price * (1 - discount / 100)).toFixed(2); %>
                  €<%= wholesalePrice %>
                  <span class="block text-sm font-normal text-green-600 mt-1">оптом (-<%= discount %>%)</span>
                  <span class="block text-xs text-gray-400 line-through">Розница: €<%= product.price.toFixed(2) %></span>
                <% } else { %>
                  €<%= product.price.toFixed(2) %> EUR
                <% } %>
              </p>

              <div class="flex justify-center gap-2 mt-4">
                <span class="text-xs px-3 py-1 bg-gray-100 rounded-full"><%= product.category || 'unisex' %></span>
                <span class="text-xs px-3 py-1 bg-gray-100 rounded-full"><%= product.type || 'pants' %></span>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full text-center py-32 bg-white rounded-2xl">
        <p class="text-2xl text-gray-500 mb-6">Товары не найдены</p>
        <a href="/catalog" class="inline-block bg-black text-white px-8 py-4 rounded-lg font-medium hover:bg-gray-800 transition">
          Показать все товары
        </a>
      </div>
    <% } %>
  </div>
</div>

<!-- Стили -->
<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fadeIn {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .product-item {
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.5s ease;
  }

  .product-item:hover {
    transform: translateY(-24px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.2);
  }

  .group:hover img {
    transform: scale(1.1);
  }
</style>

<%- include('footer') %>